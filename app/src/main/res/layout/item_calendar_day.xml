<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp" app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/transparent"> <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/btn_gradient">

    <!-- Day Number -->
    <TextView
        android:id="@+id/txtDay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Multi-Program Indicators Container -->
    <LinearLayout
        android:id="@+id/layoutIndicators"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Primary Dot (e.g., Main Program) -->
        <View
            android:id="@+id/indicatorDot1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_circle_soft"
            android:backgroundTint="@color/colorPrimary" />

        <!-- Secondary Dot (e.g., Secondary Program like Cardio) - Hidden by default -->
        <View
            android:id="@+id/indicatorDot2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_circle_soft"
            android:backgroundTint="@color/colorSecondary"
        android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
</com.google.android.material.card.MaterialCardView>